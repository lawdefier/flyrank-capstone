# Server Configuration
PORT=8000
ENVIRONMENT=development

# Database Connection (Defaults to local SQLite file; can point to PostgreSQL)
DATABASE_URL=sqlite:///./platform.db

# Geolocation Providers (Fallback Chain: Provider A -> Provider B -> Degraded)
GEO_PROVIDER_A_URL=http://ip-api.com/json/{ip}
GEO_PROVIDER_B_URL=https://ipapi.co/{ip}/json/

# Rate Limiting & Abuse Prevention
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_BURST=5

# Optional Side Effect Endpoints / Mock Toggles for Testing Probes
MOCK_GEO_FAIL_A=false
MOCK_GEO_FAIL_B=false
MOCK_EMAIL_FAIL=false
